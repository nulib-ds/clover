# Optional. Copy to .env.local for a local production build.
# Production uses DOCS_SITE_URL from GitHub Actions variables for the public URL.
NEXT_PUBLIC_SITE_URL=https://clover.iiif.library.northwestern.edu
DOCS_BASE_PATH=

# Search Console > URL-prefix property > HTML tag: the content value only.
GOOGLE_SITE_VERIFICATION=

# Google Tag Manager > Web container > Container ID (GTM-...).
# Configure Analytics inside Tag Manager; see docs/README.md.
NEXT_PUBLIC_GTM_ID=
