{
  "name": "clover",
  "private": true,
  "description": "Clover: @nulib/clover, composable IIIF components and viewer, in React or as a web component, and its documentation site.",
  "workspaces": [
    "packages/clover"
  ],
  "scripts": {
    "build": "npm run build -w @nulib/clover",
    "build:docs": "next build",
    "postbuild:docs": "pagefind --site .next/server/app --output-path out/_pagefind && node scripts/build-agent-docs.mjs",
    "build:mocks": "vite-node scripts/build-mocks.mjs",
    "build:maplibre-worker": "node ./scripts/build-maplibre-worker.mjs",
    "prebuild:docs": "npm run build:maplibre-worker && npm run build",
    "predev": "npm run build:maplibre-worker",
    "pretypecheck": "npm run build:maplibre-worker",
    "coverage": "vitest --ui --coverage",
    "dev": "next dev",
    "e2e": "npm run e2e -w @nulib/clover",
    "lint": "prettier . --check && eslint app pages packages/clover/src docs/lib docs/components/SiteEffects.tsx docs/components/ScrollTable.tsx mdx-components.tsx next.config.mjs eslint.config.mjs",
    "prettier": "prettier . --check",
    "prettier:fix": "prettier --write .",
    "start": "next start",
    "test": "vitest",
    "test:ci": "vitest run",
    "test:build": "npm run test:build -w @nulib/clover",
    "typecheck": "tsc --incremental --noEmit && npm run typecheck -w @nulib/clover"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nulib-ds/clover.git"
  },
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/nulib-ds/clover/issues"
  },
  "homepage": "https://github.com/nulib-ds/clover#readme",
  "packageManager": "npm@10",
  "engines": {
    "node": ">=20.10.0"
  },
  "devDependencies": {
    "@iiif/helpers": "^1.2.19",
    "@iiif/presentation-3": "^1.1.3",
    "@playwright/test": "^1.54.2",
    "@samvera/clover-iiif": "4.0.0-rc.2",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.0.1",
    "@types/node": "20.11.16",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitest/coverage-v8": "2.1.5",
    "@vitest/ui": "2.1.5",
    "dts-bundle-generator": "8.0.1",
    "esbuild": "^0.21.5",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.4.2",
    "eslint-config-prettier": "^10.1.8",
    "hast-util-from-html": "^2.0.3",
    "hast-util-to-mdast": "^10.1.2",
    "jsdom": "^24.1.3",
    "maplibre-gl": "^6.6.0",
    "mdast-util-gfm": "^3.1.0",
    "mdast-util-to-markdown": "^2.2.0",
    "next": "^16.4.2",
    "nextra": "^4.6.1",
    "nextra-theme-docs": "^4.6.1",
    "pagefind": "^1.5.2",
    "prettier": "^3.3.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "rimraf": "^6.0.1",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.72.0",
    "vite": "^5.4.11",
    "vite-tsconfig-paths": "^4.3.2",
    "vitest": "2.1.5"
  },
  "overrides": {
    "nextra": {
      "zod": "4.3.6"
    },
    "nextra-theme-docs": {
      "zod": "4.3.6"
    }
  }
}
