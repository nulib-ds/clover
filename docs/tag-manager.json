{
  "exportFormatVersion": 2,
  "containerVersion": {
    "containerVersionId": "0",
    "name": "Clover Analytics",
    "description": "GA4 page views from Clover documentation navigation. Enhanced measurement must be off in the GA4 stream. Imports do not publish tags.",
    "container": {
      "name": "clover.iiif.library.northwestern.edu",
      "publicId": "GTM-NFKN3GMX",
      "usageContext": ["WEB"]
    },
    "tag": [
      {
        "tagId": "1",
        "name": "Clover - Google tag",
        "type": "googtag",
        "parameter": [
          {
            "type": "TEMPLATE",
            "key": "tagId",
            "value": "{{Clover - GA4 measurement ID}}"
          },
          {
            "type": "LIST",
            "key": "configSettingsTable",
            "list": [
              {
                "type": "MAP",
                "map": [
                  {
                    "type": "TEMPLATE",
                    "key": "parameter",
                    "value": "send_page_view"
                  },
                  {
                    "type": "TEMPLATE",
                    "key": "parameterValue",
                    "value": "{{Clover - False}}"
                  }
                ]
              },
              {
                "type": "MAP",
                "map": [
                  {
                    "type": "TEMPLATE",
                    "key": "parameter",
                    "value": "page_location"
                  },
                  {
                    "type": "TEMPLATE",
                    "key": "parameterValue",
                    "value": "{{Clover - page_location}}"
                  }
                ]
              },
              {
                "type": "MAP",
                "map": [
                  {
                    "type": "TEMPLATE",
                    "key": "parameter",
                    "value": "page_title"
                  },
                  {
                    "type": "TEMPLATE",
                    "key": "parameterValue",
                    "value": "{{Clover - page_title}}"
                  }
                ]
              },
              {
                "type": "MAP",
                "map": [
                  {
                    "type": "TEMPLATE",
                    "key": "parameter",
                    "value": "page_referrer"
                  },
                  {
                    "type": "TEMPLATE",
                    "key": "parameterValue",
                    "value": "{{Clover - page_referrer}}"
                  }
                ]
              }
            ]
          }
        ],
        "firingTriggerId": ["2147479573"],
        "tagFiringOption": "ONCE_PER_EVENT",
        "monitoringMetadata": {
          "type": "MAP"
        },
        "consentSettings": {
          "consentStatus": "NOT_SET"
        }
      },
      {
        "tagId": "2",
        "name": "Clover - GA4 page view",
        "type": "gaawe",
        "parameter": [
          {
            "type": "BOOLEAN",
            "key": "sendEcommerceData",
            "value": "false"
          },
          {
            "type": "TEMPLATE",
            "key": "measurementIdOverride",
            "value": "{{Clover - GA4 measurement ID}}"
          },
          {
            "type": "TEMPLATE",
            "key": "eventName",
            "value": "page_view"
          },
          {
            "type": "LIST",
            "key": "eventSettingsTable",
            "list": [
              {
                "type": "MAP",
                "map": [
                  {
                    "type": "TEMPLATE",
                    "key": "parameter",
                    "value": "page_location"
                  },
                  {
                    "type": "TEMPLATE",
                    "key": "parameterValue",
                    "value": "{{Clover - page_location}}"
                  }
                ]
              },
              {
                "type": "MAP",
                "map": [
                  {
                    "type": "TEMPLATE",
                    "key": "parameter",
                    "value": "page_title"
                  },
                  {
                    "type": "TEMPLATE",
                    "key": "parameterValue",
                    "value": "{{Clover - page_title}}"
                  }
                ]
              },
              {
                "type": "MAP",
                "map": [
                  {
                    "type": "TEMPLATE",
                    "key": "parameter",
                    "value": "page_referrer"
                  },
                  {
                    "type": "TEMPLATE",
                    "key": "parameterValue",
                    "value": "{{Clover - page_referrer}}"
                  }
                ]
              }
            ]
          }
        ],
        "firingTriggerId": ["1"],
        "tagFiringOption": "ONCE_PER_EVENT",
        "monitoringMetadata": {
          "type": "MAP"
        },
        "consentSettings": {
          "consentStatus": "NOT_SET"
        }
      }
    ],
    "trigger": [
      {
        "triggerId": "1",
        "name": "Clover - Page view",
        "type": "CUSTOM_EVENT",
        "customEventFilter": [
          {
            "type": "EQUALS",
            "parameter": [
              {
                "type": "TEMPLATE",
                "key": "arg0",
                "value": "{{_event}}"
              },
              {
                "type": "TEMPLATE",
                "key": "arg1",
                "value": "clover_page_view"
              }
            ]
          }
        ]
      }
    ],
    "variable": [
      {
        "variableId": "1",
        "name": "Clover - GA4 measurement ID",
        "type": "c",
        "parameter": [
          {
            "type": "TEMPLATE",
            "key": "value",
            "value": "G-TYFDC4VG73"
          }
        ]
      },
      {
        "variableId": "2",
        "name": "Clover - page_location",
        "type": "v",
        "parameter": [
          {
            "type": "INTEGER",
            "key": "dataLayerVersion",
            "value": "2"
          },
          {
            "type": "TEMPLATE",
            "key": "name",
            "value": "page_location"
          },
          {
            "type": "BOOLEAN",
            "key": "setDefaultValue",
            "value": "false"
          }
        ]
      },
      {
        "variableId": "3",
        "name": "Clover - page_title",
        "type": "v",
        "parameter": [
          {
            "type": "INTEGER",
            "key": "dataLayerVersion",
            "value": "2"
          },
          {
            "type": "TEMPLATE",
            "key": "name",
            "value": "page_title"
          },
          {
            "type": "BOOLEAN",
            "key": "setDefaultValue",
            "value": "false"
          }
        ]
      },
      {
        "variableId": "4",
        "name": "Clover - page_referrer",
        "type": "v",
        "parameter": [
          {
            "type": "INTEGER",
            "key": "dataLayerVersion",
            "value": "2"
          },
          {
            "type": "TEMPLATE",
            "key": "name",
            "value": "page_referrer"
          },
          {
            "type": "BOOLEAN",
            "key": "setDefaultValue",
            "value": "false"
          }
        ]
      },
      {
        "variableId": "5",
        "name": "Clover - False",
        "type": "jsm",
        "parameter": [
          {
            "type": "TEMPLATE",
            "key": "javascript",
            "value": "function () { return false; }"
          }
        ]
      }
    ]
  }
}
