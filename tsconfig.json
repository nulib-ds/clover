{
  "compilerOptions": {
    "allowJs": true,
    "baseUrl": "./",
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "incremental": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "lib": ["dom", "dom.iterable", "esnext"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "noEmit": true,
    "paths": {
      "@nulib/clover": ["packages/clover/src/index.ts"],
      "@nulib/clover/styles.css": ["packages/clover/src/styles/clover.css"],
      "@nulib/clover/templates": ["packages/clover/src/templates/index.ts"],
      "@nulib/clover/map": ["packages/clover/src/map/index.ts"],
      "@nulib/clover/three": ["packages/clover/src/three/index.ts"],
      "@nulib/clover/templates.css": [
        "packages/clover/src/templates/templates.css"
      ],
      "docs/*": ["docs/*"]
    },
    "plugins": [
      {
        "name": "next"
      }
    ],
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "strict": false,
    "strictNullChecks": true,
    "target": "esnext",
    "types": ["vitest/globals"]
  },
  "exclude": ["dist", "node_modules", "packages", "vite.*"],
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts"
  ]
}
