over/mocks/paged/canvas/28#xywh=1404,853,2768,76"},{"id":"https://nulib-ds.github.io/clover/mocks/paged/ocr/28-lines.json#line-5","type":"Annotation","motivation":"supplementing","textGranularity":"line","body":{"type":"TextualBody","value":"to us.","format":"text/plain","language":"en"},"target":"https://nulib-ds.github.io/clover/mocks/paged/canvas/28#xywh=977,970,214,62"},{"id":"https://nulib-ds.github.io/clover/mocks/paged/ocr/28-lines.json#line-6","type":"Annotation","motivation":"supplementing","textGranularity":"line","body":{"type":"TextualBody","value":"The manufacturers of tires have ample facilities for repairing same and do so","format":"text/plain","language":"en"},"target":"https://nulib-ds.github.io/clover/mocks/paged/canvas/28#xywh=1184,950,2981,89"},{"id":"https://nulib-ds.github.io/clover/mocks/paged/ocr/28-lines.json#line-7","type":"Annotation","motivation":"supplementing","textGranularity":"line","body":{"type":"TextualBody","value":"under their guarantee free of charge. Always prepay express charges.","format":"text/plain","language":"en"},"target":"https://nulib-ds.github.io/clover/mocks/paged/canvas/28#xywh=991,1060,2629,83"},{"id":"https://nulib-ds.github.io/clover/mocks/paged/ocr/28-lines.json#line-8","type":"Annotation","motivation":"supplementing","textGranularity":"line","body":{"type":"TextualBody","value":"THE FOLLOWING ARE COPIES OF GUARANTEES GIVEN BY TIRE MANUFACTURERS.","format":"text/plain","language":"en"},"target":"https://nulib-ds.github.io/clover/mocks/paged/canvas/28#xywh=929,1204,2892,76"},{"id":"https://nulib-ds.github.io/clover/mocks/paged/ocr/28-lines.json#line-9","type":"Annotation","motivation":"supplementing","textGranularity":"line","body":{"type":"TextualBody","value":"MORGAN & WRIGHT TIRES.","format":"text/plain","language":"en"},"target":"https://nulib-ds.github.io/clover/mocks/paged/canvas/28#xywh=1955,1334,847,56"},{"id":"https://nulib-ds.github.io/clover/mocks/paged/ocr/28-lines.json#line-10","type":"Annotation","motivation":"supplementing","textGranularity":"line","body":{"type":"TextualBody","value":"We shall continue in 1896 our custom of repairing all tires of our manufacture free of charge.","format":"text/plain","language":"en"},"target":"https://nulib-ds.github.io/clover/mocks/paged/canvas/28#xywh=681,1417,2761,63"},{"id":"https://nulib-ds.github.io/clover/mocks/paged/ocr/28-lines.json#line-11","type":"Annotation","motivation":"supplementing","textGranularity":"line","body":{"type":"TextualBody","value":"We shall replace defective parts when, in our judgment, the defect is from our fault. In no case will we replace when worn","format":"text/plain","language":"en"},"target":"https://nulib-ds.github.io/clover/mocks/paged/canvas/28#xywh=681,1478,3491,79"},{"id":"https://nulib-ds.github.io/clover/mocks/paged/ocr/28-lines.json#line-12","type":"Annotation","motivation":"supplementing","textGranularity":"line","body":{"type":"TextualBody","value":"out in service or injured by accident. Make your request direct to us, and not through the makers of your wheel.","format":"text/plain","language":"en"},"target":"https://nulib-ds.github.io/clover/mocks/paged/canvas/28#xywh=571,1548,2851,69"},{"id":"https://nulib-ds.github.io/clover/mocks/paged/ocr/28-lines.json#line-13","type":"Annotation","motivation":"supplementing","textGranularity":"line","body":{"type":"TextualBody","value":"Express charges on tires must be prepaid in every instance. If return by mail is desired, postage at the rate of one cent per","format":"text/plain","language":"en"},"target":"https://nulib-ds.github.io/clover/mocks/paged/canvas/28#xywh=668,1608,3504,80"},{"id":"https://nulib-ds.github.io/clover/mocks/paged/ocr/28-lines.json#line-14","type":"Annotation","motivation":"supplementing","textGranularity":"line","body":{"type":"TextualBody","value":"ounce must come with the request for repairs. Do not send the wheel with the tire.","format":"text/plain","language":"en"},"target":"https://nulib-ds.github.io/clover/mocks/paged/canvas/28#xywh=578,1686,2472,62"},{"id":"https://nulib-ds.github.io/clover/mocks/paged/ocr/28-lines.json#line-15","type":"Annotation","motivation":"supplementing","textGranularity":"line","body":{"type":"TextualBody","value":"See that every package sent has your address securely fastened to the package.","format":"text/plain","language":"en"},"target":"https://nulib-ds.github.io/clover/mocks/paged/canvas/28#xywh=681,1761,2017,55"},{"id":"https://nulib-ds.github.io/clover/mocks/paged/ocr/28-lines.json#line-16","type":"Annotation","motivation":"supplementing","textGranularity":"line","body":{"type":"TextualBody","value":"MORGAN & WRIGHT, 331 to 339 Lake Street, Chicago, Ills.","format":"text/plain","language":"en"},"target":"https://nulib-ds.github.io/clover/mocks/paged/canvas/28#xywh=2437,1809,1645,78"},{"id":"https://nulib-ds.github.io/clover/mocks/paged/ocr/28-lines.json#line-17","type":"Annotation","motivation":"supplementing","textGranularity":"line","body":{"type":"TextualBody","value":"VIM TIRES.","format":"text/plain","language":"en"},"target":"https://nulib-ds.github.io/clover/mocks/paged/canvas/28#xywh=2210,1954,358,56"},{"id":"https://nulib-ds.github.io/clover/mocks/paged/ocr/28-lines.json#line-18","type":"Annotation","motivation":"supplementing","textGranularity":"line","body":{"type":"TextualBody","value":"We guarantee all our tires to be of perfect manufacture. We guarantee to repair all 1896 Vim tires free at any of our","format":"text/plain","language":"en"},"target":"https://nulib-ds.github.io/clover/mocks/paged/canvas/28#xywh=681,2024,3491,90"},{"id":"https://nulib-ds.github.io/clover/mocks/paged/ocr/28-lines.json#line-19","type":"Annotation","motivation":"supplementing","textGranularity":"line","body":{"type":"TextualBody","value":"repair departments during the season, but express charges must be prepaid. Tires sent by mail are at the owner's risk,","format":"text/plain","language":"en"},"target":"https://nulib-ds.github.io/clover/mocks/paged/canvas/28#xywh=578,2086,3601,100"},{"id":"https://nulib-ds.github.io/clover/mocks/paged/ocr/28-lines.json#line-20","type":"Annotation","motivation":"supplementing","textGranularity":"line","body":{"type":"TextualBody","value":"and postage at one cent per ounce must be sent for return mailing. To save time send the tire direct to our nearest repair","format":"text/plain","language":"en"},"target":"https://nulib-ds.github.io/clover/mocks/paged/canvas/28#xywh=578,2155,3601,91"},{"id":"https://nulib-ds.github.io/clover/mocks/paged/ocr/28-lines.json#line-21","type":"Annotation","motivation":"supplementing","textGranularity":"line","body":{"type":"TextualBody","value":"department, not to the bicycle manufacturer. See that your address is properly attached to the bundle.","format":"text/plain","language":"en"},"target":"https://nulib-ds.github.io/clover/mocks/paged/canvas/28#xywh=578,2226,3284,95"},{"id":"https://nulib-ds.github.io/clover/mocks/paged/ocr/28-lines.json#line-22","type":"Annotation","motivation":"supplementing","textGranularity":"line","body":{"type":"TextualBody","value":"We do not","format":"text/plain","language":"en"},"target":"https://nulib-ds.github.io/clover/mocks/paged/canvas/28#xywh=3855,2229,323,49"},{"id":"https://nulib-ds.github.io/clover/mocks/paged/ocr/28-lines.json#line-23","type":"Annotation","motivation":"supplementing","textGranularity":"line","body":{"type":"TextualBody","value":"receive tires from express companies unless the name of the sender is on them. Write us a letter under separate cover","format":"text/plain","language":"en"},"target":"https://nulib-ds.github.io/clover/mocks/paged/canvas/28#xywh=578,2297,3601,83"},{"id":"https://nulib-ds.github.io/clover/mocks/paged/ocr/28-lines.json#line-24","type":"Annotation","motivation":"supplementing","textGranularity":"line","body":{"type":"TextualBody","value":"stating how the tire is sent.","format":"text/plain","language":"en"},"target":"https://nulib-ds.github.io/clover/mocks/pa